# Proxy de convivencia: un solo dominio para la interfaz actual, la v2 y la API.
# Al compartir origen, las cookies de sesión del backend valen para ambas interfaces.
# Las variables ${...} las completa la imagen oficial de nginx al arrancar (envsubst).

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 8080;
  server_name _;
  server_tokens off;
  client_max_body_size 12m;
  # Redirecciones relativas: detrás de otro proxy, nginx no conoce el dominio ni el puerto públicos.
  absolute_redirect off;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  # Nueva interfaz.
  location /v2/ {
    proxy_pass http://${V2_UPSTREAM};
  }

  # API → backend directo.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_read_timeout 120s;
  }

  # Vitrina pública: cuando se decida, los QR ya impresos pasan a la v2. Los QR apuntan a
  # /{idioma}/q-cd/{etiqueta}/{qr}; la v2 registra la visita (estadísticas) y abre la vitrina.
  # Descomentar el bloque siguiente para activarlo.
  # location ~ ^/(?:es|en|de|rw)/(q-cd|q|p-cd)/ {
  #   rewrite ^/(?:es|en|de|rw)/(.*)$ /v2/$1 redirect;
  # }
  # location ~ ^/(q-cd|q|p-cd)/ {
  #   return 302 /v2$request_uri;
  # }

  # Todo lo demás sigue en la interfaz actual.
  location / {
    proxy_pass http://${ANTERIOR_UPSTREAM};
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
